{
  "name": "mypetlink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-strip-types scripts/build-release.mjs",
    "build:release": "node --experimental-strip-types scripts/build-release.mjs",
    "build:social-off": "node --experimental-strip-types scripts/build-release.mjs off",
    "build:social-on": "node --experimental-strip-types scripts/build-release.mjs on",
    "verify:release-flags": "node --experimental-strip-types scripts/verify-release-flags.mjs",
    "test:release-flags": "node --experimental-strip-types --test scripts/release-profile.test.mjs",
    "test:merchant-browser": "node --test scripts/merchant-directory.browser.test.mjs",
    "verify:social-flag": "node scripts/verify-social-flag.mjs",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build --project-directory . --build-output-directory out --compatibility-date 2026-07-13",
    "verify:seo": "node scripts/verify-seo-output.mjs",
    "verify:smart-tag-catalog": "node scripts/verify-smart-tag-catalog.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.functions.json"
  },
  "dependencies": {
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
