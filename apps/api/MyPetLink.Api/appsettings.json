{
  "ConnectionStrings": {
    "MyPetLinkDb": ""
  },
  "Jwt": {
    "Issuer": "MyPetLink.Api",
    "Audience": "MyPetLink.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "App_Data/uploads",
    "PublicBaseUrl": ""
  },
  "CloudflareR2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "ServiceUrl": "",
    "PublicBucketName": "mypetlink-public-media",
    "PrivateBucketName": "mypetlink-private-files",
    "PublicBaseUrl": "https://media.mypetlink.com.my",
    "PresignedUploadExpiryMinutes": 5,
    "PresignedDownloadExpiryMinutes": 5
  },
  "Features": {
    "SmartTagOrderingEnabled": false
  },
  "PublicSite": {
    "BaseUrl": ""
  },
  "Email": {
    "Enabled": false,
    "Provider": "Smtp",
    "FromAddress": "support@mypetlink.com.my",
    "FromName": "MyPetLink",
    "OwnerPortalBaseUrl": "https://mypetlink.com.my",
    "BrandLogoUrl": "https://mypetlink.com.my/logo-horizontal.png",
    "BrandAssetBaseUrl": "https://mypetlink.com.my/email-assets",
    "Templates": {
      "OwnerWelcomeEnabled": false
    },
    "Smtp": {
      "Host": "smtppro.zoho.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "ConnectionTimeoutSeconds": 30
    },
    "Dispatch": {
      "PollIntervalSeconds": 10,
      "BatchSize": 10,
      "MaxConcurrency": 2,
      "VisibilityTimeoutSeconds": 120
    }
  },
  "DatabaseResilience": {
    "MaxRetryCount": 6,
    "MaxRetryDelaySeconds": 10,
    "ApiRetryAfterSeconds": 3
  },
  "RateLimiting": {
    "PublicTagScan": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "TagActivation": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 2,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
