{
  "ConnectionStrings": {
    "MyPetLinkDb": "Server=(localdb)\\MSSQLLocalDB;Database=MyPetLinkDev;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "MyPetLink.Api",
    "Audience": "MyPetLink.Local",
    "SigningKey": "development-only-my-pet-link-signing-key-change-me",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "AdminSeed": {
    "Emails": []
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3001"
    ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "App_Data/uploads",
    "PublicBaseUrl": ""
  },
  "CloudflareR2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "ServiceUrl": "",
    "PublicBucketName": "mypetlink-public-media",
    "PrivateBucketName": "mypetlink-private-files",
    "PublicBaseUrl": "https://media.mypetlink.com.my",
    "PresignedUploadExpiryMinutes": 5,
    "PresignedDownloadExpiryMinutes": 5
  },
  "Features": {
    "SmartTagOrderingEnabled": true
  },
  "PublicSite": {
    "BaseUrl": "http://localhost:3000"
  },
  "Email": {
    "Enabled": false,
    "Provider": "Development",
    "FromAddress": "support@mypetlink.com.my",
    "FromName": "MyPetLink",
    "OwnerPortalBaseUrl": "http://localhost:3000",
    "BrandLogoUrl": "https://mypetlink.com.my/logo-horizontal.png",
    "BrandAssetBaseUrl": "https://mypetlink.com.my/email-assets",
    "Smtp": {
      "Host": "smtppro.zoho.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "ConnectionTimeoutSeconds": 30
    },
    "Dispatch": {
      "PollIntervalSeconds": 2,
      "BatchSize": 10,
      "MaxConcurrency": 2,
      "VisibilityTimeoutSeconds": 120
    }
  },
  "DatabaseResilience": {
    "MaxRetryCount": 6,
    "MaxRetryDelaySeconds": 10,
    "ApiRetryAfterSeconds": 3
  },
  "RateLimiting": {
    "PublicTagScan": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "TagActivation": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
