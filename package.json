{
  "name": "mypetlink",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "build:web-functions": "npm --workspace apps/web run build:functions",
    "start:web": "npm --workspace apps/web run start",
    "lint:web": "npm --workspace apps/web run lint",
    "test:web": "npm --workspace apps/web run test",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "xhs:check": "node marketing/xiaohongshu/production/scripts/check.mjs",
    "xhs:capture": "node marketing/xiaohongshu/production/scripts/capture.mjs",
    "xhs:build": "node marketing/xiaohongshu/production/scripts/build.mjs",
    "xhs:cover": "node marketing/xiaohongshu/production/scripts/cover.mjs",
    "xhs:inspect": "node marketing/xiaohongshu/production/scripts/inspect.mjs",
    "xhs:setup": "playwright-core install ffmpeg"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3"
  }
}
